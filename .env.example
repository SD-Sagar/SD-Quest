# =============================================================================
# SD-QUEST: ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.local and fill in your Supabase project credentials.
# You can obtain these from your Supabase Dashboard:
# Navigate to: Project Settings -> API (https://supabase.com/dashboard/project/_/settings/api)

# -----------------------------------------------------------------------------
# SUPABASE PUBLIC CONFIGURATION (Exposed to Browser & Server)
# -----------------------------------------------------------------------------
# Your Supabase project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase Anon / Public Key (Safe for browser client, governed by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SUPABASE ADMIN / SERVER SECRET (Strictly Server-Side Only)
# -----------------------------------------------------------------------------
# Your Supabase Service Role Key (Bypasses RLS for administrative tasks like auto-confirming emails)
# WARNING: Keep this secret! Never prefix with NEXT_PUBLIC_ or expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
